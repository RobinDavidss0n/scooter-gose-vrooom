    style MCP_VDD fill:#d32f2f,color:#ffffff
    style MCP_GPB0 fill:#00bcd4,color:#000000
    style PWR12V fill:#e6c400,color:#000000
    style RL_P fill:#e6c400,color:#000000
    style FL_P fill:#e6c400,color:#000000
    style MCP_SCL fill:#8b4513,color:#ffffff
    style MCP_SDA fill:#808080,color:#ffffff
