flowchart LR
    subgraph CHASSIS[CHASSIS — Battery, VESC, Rear Light]
        B[Battery 36V] == 36V+ & GND ==> XT60[XT60 Junction]

        %% Soft power switch: gates the VESC only, not SD. SD (and its 12V rail)
        %% must stay always-on so there's power available to bootstrap the latch
        %% below from a fully-off state — see PWR_RELAY/PWR_LATCH. Nothing else
        %% draws current from 12V while "off" since all light MOSFET gates default
        %% low via their pull-downs whenever the MCU/expander isn't driving them.
        %% Relay sized against the VESC's actual configured battery current max
        %% (20-25A safe/overdrive, ~30A theoretical-with-degradation ceiling — see
        %% vesc/setup.md) — 40A contacts give comfortable margin.
        XT60 -- 36V+ --> PWR_RELAY_COM(COM — Pin 30)
        XT60 -- GND --> VESC[VESC]
        VESC --- COMM

        subgraph PWR_RELAY["Power Relay — JD1912, 12V coil, 40A SPST-NO, built-in flyback diode"]
            PWR_RELAY_COM
            PWR_RELAY_NO(NO — Pin 87)
            PWR_RELAY_COILP(Coil + — Pin 86)
            PWR_RELAY_COILN(Coil - — Pin 85)
        end
        PWR_RELAY_COM -. "closes when coil energized" .-> PWR_RELAY_NO
        PWR_RELAY_NO -- 36V+ switched --> VESC

        %% Latch: either the button (bootstrap, from fully off) or the MCU's hold
        %% signal (once booted) can independently pull the transistor on via the
        %% diode-OR. Releasing both — i.e. MCU releases hold and button isn't
        %% being pressed — drops the relay and cuts power to the whole system.
        SD -- 12V+ OUT --> PWR_RELAY_COILP
        PWR_RELAY_COILN --> PWR_LATCH_Q_C(Collector)
        CG --- PWR_LATCH_Q_E(Emitter)
        LATCH_NODE((Diode-OR)) -- 1kΩ --> PWR_LATCH_Q_B(Base)

        subgraph PWR_LATCH["Power Latch — small NPN, e.g. BC337"]
            PWR_LATCH_Q_B
            PWR_LATCH_Q_C
            PWR_LATCH_Q_E
        end

        D_BTN[Diode 1N4148] --> LATCH_NODE
        D_HOLD[Diode 1N4148] --> LATCH_NODE

        %% MOSFET leg wiring (same on all 4 MOSFETs here, TO-220 package, text side facing you,
        %% pins left-to-right = Gate/Drain/Source): White=Gate, Grey=Drain, Black=Source
        SD -- 12V+ OUT --> RL_P((Rear Light + — Yellow))
        RL_M((Rear Light -)) --> MOS_R_D(Drain Pin 2 — Grey)

        %% Common Ground: star point for CHASSIS — bonds SD's clean output + VESC's COMM/accessory ground here (VESC's main/motor-current ground pin stays unconnected, avoiding a ground loop)
        CG((Common Ground — Black))
        SD -- GND OUT --> CG
        COMM_GND -- GND --> CG
        CG --- MOS_R_S(Source Pin 3 — Black)
        MOS_R_G -. 10kΩ Pull-down .- CG

        subgraph MOSFET_REAR[Rear MOSFET IRLB8721]
            MOS_R_G(Gate Pin 1 — White)
            MOS_R_D
            MOS_R_S
        end

        %% Runs straight to 12V, no separate step-up board needed
        XT60 -- 36V+ --> SD["XL7015 Step-down<br>(adjusted to 12V output)"]
        XT60 -- GND --> SD

        %% Pin numbers follow top-to-bottom order in the board photo, not a confirmed silkscreen Pin 1 - verify before soldering
        subgraph COMM["VESC COMM Header (6 COMM, MKS ESC Mini Pro V6.70)"]
            COMM_ADC3(Pin 1: ADC3 - unused)
            COMM_ADC2(Pin 2: ADC2 - unused)
            COMM_TX(Pin 3: TX/SCL)
            COMM_RX(Pin 4: RX/SDA)
            COMM_ADC1(Pin 5: ADC1 - unused)
            COMM_GND(Pin 6: GND)
            COMM_3V3(Pin 7: 3.3V - unused)
            COMM_5V(Pin 8: 5V)
        end
    end

    subgraph FERRITE["Ferrite Core Clamp — full STEM bundle (CHASSIS end)"]
        FE1(OG1 pass-through — Blue)
        FE2(OG2 pass-through — Green)
        FE3(OG3 pass-through — Light Gray)
        FE4(OG4 pass-through — Red)
        FE5(OG5 pass-through — Yellow)
        FEN(N1 pass-through — Black)
        FE_N2(N2 pass-through — Pink)
        FE_N3(N3 pass-through — Cyan)
    end

    %% Wire colors chosen to match the MCU's own ribbon below wherever the STEM's existing 6-wire
    %% bundle allows it (TX=Blue, RX=Green, GND=Black, 5V=Red match on both cables) so the same
    %% signal looks the same color end-to-end, even though the two cables are physically separate.
    subgraph STEM["STEM WIRING (folding joint) — bundled with heat-shrink in segments"]
        subgraph ORIGINAL_CABLE[Original cable, 5 conductors — now logic + power]
            OG1["1: UART TX — Blue"]
            OG2["2: UART RX — Green"]
            OG3["3: GPIO brake signal — Light Gray"]
            OG4["4: 5V+ — Red"]
            OG5["5: 12V+ to front light — Yellow"]
        end
        subgraph NEW_CABLE[New cable, 3x 0.75mm² — GND + power-switch control]
            N1["N1: Common GND — Black"]
            N2["N2: Power button trigger — Pink"]
            N3["N3: MCU power-hold — Cyan"]
        end
    end

    subgraph HANDLEBARS[HANDLEBARS — MCU, Front Light]
        PWR5V((5V Local — Red))
        subgraph C1_ELCO[C1a: Electrolytic 470-1000µF 16V]
            C1E_POS(Anode +)
            C1E_NEG(Cathode -)
        end
        subgraph C1_CER[C1b: Ceramic 100nF]
            C1C_1(Pin 1)
            C1C_2(Pin 2)
        end
        PWR5V -.-> C1E_POS
        C1E_NEG -.- HB_GND
        PWR5V -.-> C1C_1
        C1C_2 -.- HB_GND
        PWR5V --> MCU_VSYS
        HB_GND((Handlebar Ground — Black))
        PWR12V((12V Local — Yellow))
        PWR12V --> FL_P((Front Light + — Yellow))
        FL_M((Front Light -)) --> MOS_F_D(Drain Pin 2 — Grey)

        %% Power button: single-pole momentary, taps the always-on local 12V rail
        %% directly (no separate reference voltage needed) and sends a switched-12V
        %% trigger down N2 to bootstrap the chassis latch — see CHASSIS PWR_LATCH.
        %% Hold the button briefly (~1s) on power-up: it only needs to bridge the
        %% gap until the MCU boots and asserts its own hold signal on MCP_GPB0.
        %%
        %% The MCU also reads this same button locally (MCP_GPB1) — no second wire
        %% down to chassis needed, and no second pole on the button either. A
        %% 10kΩ/3.3kΩ divider on the button's own switched-12V signal scales it to
        %% ~3V when pressed (0V idle via the bottom resistor to HB_GND), safely
        %% under the MCP23017's 3.3V logic / 5.5V abs-max. This reads ACTIVE-HIGH,
        %% unlike BTN_L/BTN_R which are active-low via internal pull-up — see
        %% power.cpp. Held for 2s while running, it triggers a graceful shutdown
        %% (zero throttle/brake, stop the VESC, release the hold line); a short tap
        %% does nothing, so a debounce glitch or bump can't cut power mid-ride.
        PWR_BTN((Power Button))
        PWR12V -- 12V+ --> PWR_BTN
        PWR_BTN --> PWR_BTN_SIG((Switched 12V))
        PWR_BTN_SIG --> N2
        PWR_BTN_SIG -- 10kΩ --> PWR_BTN_SENSE((~3V when pressed))
        PWR_BTN_SENSE -. 3k3 .- HB_GND
        PWR_BTN_SENSE --> MCP_GPB1

        %% GPIO15/21 chosen from the exposed header's free pins (16/17/18 already used for throttle/UART)
        %% GPIO33/GPIO0 were the last 2 free pins on the header. GPIO0/BOOT is a strapping pin that
        %% gets re-sampled on every chip reset (not just power-on) — a reset landing while I2C toggles
        %% it low could drop the board into UART download mode instead of resuming firmware, so it's
        %% left unconnected (N/C, floating) rather than used for SCL.
        %% Front light moved off the MCU onto the MCP23017 expander (plain on/off, no PWM needed —
        %% it was never dimmed at runtime anyway) to free GPIO15 for SCL instead.
        %% Colors below are the board's own 12-wire ribbon, fixed top-to-bottom order (pin-definition.png):
        %% GND=Black, VSYS=Red, RESET=Green, BOOT=Yellow (N/C), GND=Black(2nd, same net), 3V3=Red,
        %% GPIO15=Brown, GPIO16=Orange, GPIO17=Green, GPIO18=Blue, GPIO21=Purple, GPIO33=Grey.
        %% CAUTION: VSYS and 3V3 are both Red on this ribbon — tag one before wiring, since crossing
        %% them feeds 5V into the 3.3V-only MCP23017 (abs max ~5.5V, very little margin).
        subgraph MCU["ESP32-S3-Touch-LCD-1.28"]
            MCU_GND(GND — Black)
            MCU_VSYS(VSYS - 5V in — Red)
            MCU_RESET(RESET - unused — Green)
            MCU_BOOT(GPIO0/BOOT - N/C, do not wire — Yellow)
            MCU_3V3(3V3 - 3.3V out — Red)
            MCU_SCL(GPIO15: I2C SCL — Brown)
            MCU_THROTTLE(GPIO16: Throttle ADC — Orange)
            MCU_RX(GPIO17: UART RX — Green)
            MCU_TX(GPIO18: UART TX — Blue)
            MCU_REAR(GPIO21: Rear light gate signal — Purple)
            MCU_SDA(GPIO33: I2C SDA — Grey)
        end
        MCU_GND --- HB_GND

        subgraph MOSFET_FRONT[Front MOSFET IRLB8721]
            MOS_F_G
            MOS_F_D
            MOS_F_S
        end

        %% MCP23017 needs 3.3V logic to match the ESP32-S3's I2C pins (ESP32 GPIOs aren't 5V tolerant) —
        %% the header already breaks out a native 3V3 pin, so no separate LDO is needed
        MCU_3V3 -- 3.3V --> MCP_VDD

        %% Turn-signal L/R buttons double as speed-limit adjust buttons (firmware-arbitrated, see
        %% blinkers.cpp) — both button inputs and blinker LED outputs live on the expander so the
        %% blink function can be fully disabled in software when in unrestricted-speed mode
        MCU_SDA -- I2C SDA --> MCP_SDA
        MCU_SCL -- I2C SCL --> MCP_SCL

        subgraph EXPANDER["MCP23017 I2C GPIO Expander (addr 0x20)"]
            MCP_SDA(SDA — Grey)
            MCP_SCL(SCL — Brown)
            MCP_VDD(VDD — Red)
            MCP_GND(GND — Black)
            MCP_GPA0(GPA0: BTN Left in)
            MCP_GPA1(GPA1: BTN Right in)
            MCP_GPA2(GPA2: Blink Left out)
            MCP_GPA3(GPA3: Blink Right out)
            MCP_GPA4(GPA4: Front light out)
            MCP_GPB0(GPB0: Power hold out)
            MCP_GPB1(GPB1: Power button sense in)
        end
        MCP_GND --- HB_GND

        %% Front MOSFET lives locally at the handlebars, driven from the expander (not the MCU
        %% directly) — freed GPIO15 on the MCU so I2C SCL could move off GPIO0/BOOT (see MCU note above)
        MCP_GPA4 -- Gate --> R1_100[100Ω] --> MOS_F_G(Gate Pin 1 — White)
        MOS_F_G -. 10kΩ Pull-down .- HB_GND
        HB_GND --- MOS_F_S(Source Pin 3 — Black)

        BTN_L((Left Turn /<br>Speed− Button)) --- MCP_GPA0
        BTN_L --- HB_GND
        BTN_R((Right Turn /<br>Speed+ Button)) --- MCP_GPA1
        BTN_R --- HB_GND

        %% Blinkers turned out to be the same 12V LED modules as front/rear (measured 0.11A@12V) —
        %% not small 5V indicator LEDs, so they use the same low-side MOSFET pattern as the other
        %% lights instead of an NPN. Mounted at the handlebar cluster — no spare STEM conductor left
        %% to route them elsewhere, so they tap the 12V already delivered here for the front light.
        %% XL7015 has plenty of headroom for all 4 lights at once (7W recommended vs ~3.6-4W worst
        %% case, see repo notes) — wired straight to 12V, no current-limiting resistor needed.
        PWR12V --> LED_L((Left Blinker LED)) --> MOS_BL_D(Drain Pin 2 — Grey)
        MCP_GPA2 -- Gate --> R3_100[100Ω] --> MOS_BL_G(Gate Pin 1 — White)
        MOS_BL_G -. 10kΩ Pull-down .- HB_GND
        HB_GND --- MOS_BL_S(Source Pin 3 — Black)
        subgraph MOSFET_BLINK_L[Left Blinker MOSFET IRLB8721]
            MOS_BL_G
            MOS_BL_D
            MOS_BL_S
        end

        PWR12V --> LED_R((Right Blinker LED)) --> MOS_BR_D(Drain Pin 2 — Grey)
        MCP_GPA3 -- Gate --> R4_100[100Ω] --> MOS_BR_G(Gate Pin 1 — White)
        MOS_BR_G -. 10kΩ Pull-down .- HB_GND
        HB_GND --- MOS_BR_S(Source Pin 3 — Black)
        subgraph MOSFET_BLINK_R[Right Blinker MOSFET IRLB8721]
            MOS_BR_G
            MOS_BR_D
            MOS_BR_S
        end
    end

    %% Original cable (logic + power) — VESC RX/SDA receives MCU's TX, VESC TX/SCL feeds MCU's RX
    MCU_TX -- "TX (Blue)" --> OG1 --> FE1 --> COMM_RX
    COMM_TX -- "RX (Green)" --> FE2 --> OG2 --> MCU_RX
    MCU_REAR -- "GPIO Rear, brake status (Light Gray)" --> OG3 --> FE3 --> R2_100[100Ω] --> MOS_R_G
    COMM_5V -- "5V+ (Red)" --> FE4 --> OG4 --> PWR5V
    SD -- "12V+ OUT (Yellow)" --> FE5 --> OG5 --> PWR12V

    %% New cable (common ground return, plus the 2 power-switch control signals —
    %% both logic-level, negligible current, share N1's existing ground return)
    CG -- "GND (Black)" --> FEN --> N1 --> HB_GND
    N2 -- "Trigger (Pink)" --> FE_N2 --> D_BTN
    MCP_GPB0 -- "Hold (Cyan)" --> N3 --> FE_N3 --> D_HOLD

    %% Wire-color legend (cosmetic node fills matching the physical cable colors described above)
    style N1 fill:#000000,color:#ffffff
    style N2 fill:#ff69b4,color:#000000
    style N3 fill:#00bcd4,color:#000000
    style OG1 fill:#1f6feb,color:#ffffff
    style OG2 fill:#2ea043,color:#ffffff
    style OG3 fill:#d3d3d3,color:#000000
    style OG4 fill:#d32f2f,color:#ffffff
    style OG5 fill:#e6c400,color:#000000
    style COMM_RX fill:#1f6feb,color:#ffffff
    style COMM_TX fill:#2ea043,color:#ffffff
    style COMM_GND fill:#000000,color:#ffffff
    style COMM_5V fill:#d32f2f,color:#ffffff
    style MCU_GND fill:#000000,color:#ffffff
    style MCU_VSYS fill:#d32f2f,color:#ffffff
    style MCU_RESET fill:#2ea043,color:#ffffff
    style MCU_BOOT fill:#e6c400,color:#000000,stroke-dasharray: 4 3
    style MCU_SCL fill:#8b4513,color:#ffffff
